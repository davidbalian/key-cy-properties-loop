# Messages
msgid "No properties found matching your criteria."
msgstr "Не найдено объектов, соответствующих вашим критериям."

msgid "No properties found matching your filters."
msgstr "Не найдено объектов, соответствующих вашим фильтрам."

msgid "Try adjusting your search criteria."
msgstr "Попробуйте изменить критерии поиска."

msgid "No favourites yet"
msgstr "Пока нет избранного"

msgid "Tap the star on any property to save it here."
msgstr "Нажмите на звездочку у любого объекта, чтобы сохранить его здесь."

msgid "Sign in to view favourites"
msgstr "Войдите, чтобы просмотреть избранное"

msgid "You need to be logged in to save and view favourites."
msgstr "Вам необходимо войти в систему, чтобы сохранять и просматривать избранное."

