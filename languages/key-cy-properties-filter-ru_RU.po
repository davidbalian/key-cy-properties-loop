msgstr "Цена"

msgid "Property Type"
msgstr "Тип недвижимости"

msgid "Property ID"
msgstr "ID недвижимости"

# Buttons
msgid "Apply Filters"
msgstr "Применить фильтры"

msgid "Reset Filters"
msgstr "Сбросить фильтры"

msgid "Load More"
msgstr "Загрузить еще"

